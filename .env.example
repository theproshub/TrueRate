# Supabase (Vercel Marketplace integration auto-provisions these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role — server-only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron secret — authenticates /api/cron/* route handlers
CRON_SECRET=

# Postgres connection strings (auto-provisioned, not currently used in src/)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
